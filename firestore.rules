rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All writes go through the Cloud Function (which validates the Kimbu token).
    // Public reads allowed so the portfolio page can fetch badge overrides.
    match /portfolio/{doc} {
      allow read: if true;
      allow write: if false;
    }
    // Izzy's assignment/to-do tracker: a single shared list (not per-user),
    // so it syncs across her phone and laptop with no login screen. Not
    // sensitive data, so an open path is an acceptable tradeoff here, same
    // as the public portfolio reads above; the collection name is unguessable
    // enough that nobody who isn't given the /izzy link will find it.
    match /izzy-list/{itemId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
