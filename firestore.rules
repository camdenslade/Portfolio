rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All writes go through the Cloud Function (which validates the Kimbu token).
    // Public reads allowed so the portfolio page can fetch badge overrides.
    match /portfolio/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
